# Kamala Science Campus — server configuration

# One address for search engines. www and Hostinger's temporary domain serve
# the same site, so Google could list it under either, or split it between
# them; send both to the real domain, keeping the path and query string.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.kamalasciencecampus\.edu\.np [NC,OR]
  RewriteCond %{HTTP_HOST} \.hostingersite\.com [NC]
  RewriteRule ^ https://kamalasciencecampus.edu.np%{REQUEST_URI} [R=302,L]
</IfModule>

# The repository root is deployed straight into public_html, which would
# otherwise serve the build sources alongside the real pages. Hide them:
# /src/pages/*.html are headless duplicates of every page (bad for indexing),
# and build.py / README.md / .claude are development files.
RedirectMatch 404 ^/(src|sql|\.claude)(/|$)
RedirectMatch 404 ^/(build\.py|README\.md)$

# Never serve the repository metadata
RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 ^/\.gitignore$

# The installer has done its job. Hostinger's git deploy does not delete files
# removed from the repository, so block it here as well as deleting it.
RedirectMatch 404 ^/portal/install\.php$

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # No other site may frame these pages (clickjacking), browsers remember to
  # use HTTPS for six months, and the PHP version is not advertised.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always unset X-Powered-By
  # Pages must be rechecked on every visit, by browsers and by Hostinger's
  # CDN, or a push can take up to an hour to appear (and different CDN
  # servers show different versions meanwhile). CSS and JS keep their long
  # caches because build.py versions their URLs.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
